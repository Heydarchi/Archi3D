# An Android app in the recommended layered architecture (UI, domain, data),
# with the platform services and the backend it talks to.
# Link kinds: -> call, => message, ~> event, <=> session, >> stream, <> shared.

user User "Phone user"          out: touch

app NotesApp "Notes app" {
  container UiLayer "UI layer" {
    ui MainActivity             in: touch          out: nav
    ui NoteListFragment "Note list"  in: show, state   out: action
    ui EditorFragment   "Editor"     in: show, state   out: action
    component NotesViewModel "ViewModel"  in: action  out: list, save, state
  }
  container DomainLayer "Domain layer" {
    component GetNotesUseCase   in: run            out: notes
    component SaveNoteUseCase   in: run            out: notes, sync
  }
  container DataLayer "Data layer" {
    component NotesRepository "Repository"  in: notes, refresh  out: local, cache, remote, prefs
    database RoomDatabase "Room"     in: dao:SQL
    cache    NotesCache   "Memory cache"  in: get
    storage  DataStore    "DataStore prefs" in: prefs
    library  RetrofitClient "Retrofit"    in: call   out: https:REST
    service  SyncWorker   "Sync worker"   in: work   out: push
  }
  service PushService "FCM service"     in: message    out: refresh
}

system AndroidPlatform "Android platform" {
  service WorkManager           in: schedule       out: run
  service FirebaseMessaging "Firebase Messaging"  in: register  out: deliver
  topic   Connectivity "Network broadcasts"       out: changed
}

external NotesBackend "Notes backend"  in: api:REST   out: fcm

User.touch                 -> MainActivity.touch : tap
MainActivity.nav           -> NoteListFragment.show, EditorFragment.show
NoteListFragment.action    -> NotesViewModel.action
EditorFragment.action      -> NotesViewModel.action
NotesViewModel.state       ~> NoteListFragment.state, EditorFragment.state : StateFlow
NotesViewModel.list        -> GetNotesUseCase.run
NotesViewModel.save        -> SaveNoteUseCase.run
GetNotesUseCase.notes      -> NotesRepository.notes
SaveNoteUseCase.notes      -> NotesRepository.notes
SaveNoteUseCase.sync       => WorkManager.schedule : OneTimeWorkRequest
WorkManager.run            => SyncWorker.work
Connectivity.changed       ~> WorkManager.schedule : CONNECTIVITY_CHANGE
SyncWorker.push            -> RetrofitClient.call
NotesRepository.local      -> RoomDatabase.dao
NotesRepository.cache      -> NotesCache.get
NotesRepository.prefs      -> DataStore.prefs
NotesRepository.remote     -> RetrofitClient.call
RetrofitClient.https       -> NotesBackend.api
NotesBackend.fcm           => FirebaseMessaging.register : push
FirebaseMessaging.deliver  => PushService.message
PushService.refresh        => NotesRepository.refresh : refresh
