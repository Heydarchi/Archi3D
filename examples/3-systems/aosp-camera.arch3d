# How the AOSP stack serves one camera preview: an app opens the camera through the
# framework, Binder carries the call to native services, which drive the HAL and the kernel.
# -> Binder or HAL call, <=> open session, ~> callback, >> frames, <> shared buffers.

user User "Phone user"           out: tap

system Apps {
  app CameraApp "Camera app"     in: tap, onOpened, frames   out: open, preview, perm
}

system Framework "Android framework" {
  container JavaApi "Java API" {
    library CameraManager        in: open, status       out: binder:AIDL
    library CameraDevice         in: request, cb        out: binder:AIDL, onOpened
    library Surface              in: buffers            out: frames
  }
}

system SystemServer "system_server" {
  service ActivityManagerService "ActivityManager"  in: check:AIDL
  service PackageManagerService  "PackageManager"   in: perm:AIDL
  service WindowManagerService   "WindowManager"    in: layout
}

system NativeServices "Native services" {
  container cameraserver {
    service CameraService        in: connect:AIDL       out: hal:AIDL, permission:AIDL, cb, status
    service Camera3Device        in: submit:AIDL        out: hal:AIDL, buffers
  }
  container surfaceflinger {
    service SurfaceFlinger       in: queue              out: compose
    queue   BufferQueue          in: produce            out: consume
  }
  service ServiceManager         in: lookup:AIDL
}

system HAL {
  service CameraProvider "ICameraProvider"    in: provider:AIDL   out: device
  library CameraDeviceHal "ICameraDeviceSession"  in: session:AIDL, frames   out: ioctl, results
  library Gralloc                in: alloc
  service HWComposer "HW Composer"  in: present
}

system Kernel "Linux kernel" {
  container Drivers {
    driver V4L2Driver "V4L2 driver"     in: ioctl, mipi    out: frames
    driver Ion "DMA-BUF heaps"          in: dmabuf
    driver DisplayDriver "Display (KMS)"  in: kms         out: panel
  }
}
device ImageSensor "Image sensor"   in: i2c   out: mipi
device Panel "Display panel"        in: dsi

User.tap                        -> CameraApp.tap
CameraApp.perm                  -> PackageManagerService.perm : CAMERA permission
CameraApp.open                  -> CameraManager.open : openCamera()
CameraManager.binder            -> ServiceManager.lookup : getService("media.camera")
CameraManager.binder            -> CameraService.connect : connectDevice()
CameraService.status            ~> CameraManager.status : onStatusChanged
CameraService.permission        -> ActivityManagerService.check : checkPermission
CameraService.hal               -> CameraProvider.provider : getCameraDeviceInterface
CameraProvider.device           -> CameraDeviceHal.session : open()
CameraService.cb                ~> CameraDevice.cb : onOpened
CameraDevice.onOpened           ~> CameraApp.onOpened
CameraApp.preview               -> CameraDevice.request : setRepeatingRequest
CameraDevice.binder            <=> Camera3Device.submit : ICameraDeviceUser
Camera3Device.hal              <=> CameraDeviceHal.session : processCaptureRequest
CameraDeviceHal.ioctl           -> V4L2Driver.ioctl : VIDIOC_QBUF
V4L2Driver                      -> ImageSensor.i2c : stream on
ImageSensor.mipi                >> V4L2Driver.mipi : MIPI CSI-2
V4L2Driver.frames               >> CameraDeviceHal.frames : frames
CameraDeviceHal.results         ~> Camera3Device.submit : processCaptureResult
CameraDeviceHal                 <> Gralloc : gralloc buffers
Camera3Device.buffers           >> BufferQueue.produce : queueBuffer
BufferQueue                     -> Gralloc.alloc : allocate
Gralloc                         <> Ion.dmabuf : dmabuf
BufferQueue.consume             >> SurfaceFlinger.queue : acquireBuffer
BufferQueue.consume             >> Surface.buffers
Surface.frames                  >> CameraApp.frames : TextureView
SurfaceFlinger.compose          -> HWComposer.present : presentDisplay
HWComposer                      -> DisplayDriver.kms : atomic commit
DisplayDriver.panel             >> Panel.dsi : DSI
WindowManagerService            -> SurfaceFlinger.queue : layer transaction
