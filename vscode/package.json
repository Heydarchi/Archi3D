{
  "name": "archi3d",
  "displayName": "Archi3D",
  "description": "Live 3D preview of software architecture models (.arch, Mermaid architecture-beta): components, ports and links stacked by nesting level.",
  "version": "0.1.0",
  "publisher": "archi3d-local",
  "license": "SEE LICENSE IN README.md",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Visualization", "Programming Languages"],
  "keywords": ["architecture", "diagram", "3d", "c4", "mermaid"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:arch", "workspaceContains:**/*.{arch,mmd}"],
  "contributes": {
    "languages": [
      {
        "id": "arch",
        "aliases": ["Archi3D", "arch"],
        "extensions": [".arch"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "arch", "scopeName": "source.arch", "path": "./syntaxes/arch.tmLanguage.json" }
    ],
    "commands": [
      { "command": "archi3d.openPreview", "title": "Open 3D Preview to the Side", "category": "Archi3D", "icon": "$(open-preview)" },
      { "command": "archi3d.savePng", "title": "Save 3D Preview as PNG…", "category": "Archi3D" },
      { "command": "archi3d.exportHtml", "title": "Export Standalone HTML…", "category": "Archi3D" }
    ],
    "menus": {
      "editor/title": [
        { "command": "archi3d.openPreview", "when": "editorLangId == arch || resourceExtname == .mmd", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "archi3d.openPreview", "when": "editorLangId == arch || resourceExtname == .mmd" },
        { "command": "archi3d.exportHtml", "when": "editorLangId == arch || resourceExtname == .mmd" }
      ]
    },
    "keybindings": [
      { "command": "archi3d.openPreview", "key": "ctrl+k v", "mac": "cmd+k v", "when": "editorLangId == arch" }
    ]
  }
}
